# Existing application settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easydraw
JWT_SECRET=replace-me
CLIENT_URL=http://localhost:5173

# Private S3 bucket used for the shared library and user-uploaded images.
AWS_REGION=ap-southeast-2
AWS_S3_ASSETS_BUCKET=easydraw-user-assets

# Local development only. In ECS, attach an IAM task role instead of setting
# long-lived access keys in the container environment.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional limits (defaults shown).
ASSET_MAX_FILE_BYTES=10485760
ASSET_USER_QUOTA_BYTES=104857600
